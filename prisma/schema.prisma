// Prisma schema for the gym tracker app.
//
// KEY DESIGN DECISIONS (documented per the brief):
//
// 1. Templates vs Sessions:
//    - `WorkoutDay` + `WorkoutExercise` = the PLAN for a given week/day
//      (e.g. "Week 3, Monday = Shoulders, Shoulder Press planned 3x10").
//    - `WorkoutSession` + `SessionExercise` = the ACTUAL logged results for
//      that day. Editing this week's results never touches last week's
//      WorkoutDay/Session rows, because each week has its own rows.
//
// 2. Exercise identity survives renames:
//    - `Exercise` is its own table with a stable id. WorkoutExercise and
//      SessionExercise reference exercise.id, not a name string. Renaming
//      Exercise.name does not break history or progression, since every
//      historical row still points at the same id.
//
// 3. Flexible set/cardio data:
//    - Rather than a rigid Set table forcing identical structure across
//      exercise types, planned/actual set data is stored as JSON
//      (`plannedSets` / `actualSets`). Strength: array of {reps, weightKg,
//      completed}. Cardio: {timeSec, distanceKm, level, completed}.
//
// 4. Multi-profile support:
//    - `User` is a lightweight named profile, not a full account system —
//      no email required, an optional short PIN only. `Week`, `Exercise`,
//      `BodyMetric`, and `ProgramSettings` each belong to a User, so two
//      people sharing the same deployment never see each other's data.
//      `WorkoutDay`/`WorkoutExercise`/`WorkoutSession`/`SessionExercise`
//      don't need their own userId — they're only reachable through a Week
//      or Exercise that's already scoped to one user.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseType {
  STRENGTH
  CARDIO
}

model User {
  id        String   @id @default(cuid())
  name      String
  pinHash   String?
  role      String   @default("user") // "user" | "admin" — first profile created becomes admin
  createdAt DateTime @default(now())

  // Onboarding / goal profile (Phase 2). onboardingCompleted defaults to
  // true so it never retroactively interrupts profiles that already
  // existed before this was added — it's explicitly set to false only when
  // a brand-new profile is created going forward.
  onboardingCompleted  Boolean   @default(true)
  primaryGoalId        String?
  primaryGoal          GoalCategory? @relation(fields: [primaryGoalId], references: [id])
  goalDescription      String?
  experienceLevel      String? // "Beginner" | "Intermediate" | "Advanced"
  trainingDaysPerWeek  Int?
  preferredTrainingType String? // "Strength" | "Cardio" | "Mixture"
  equipmentAvailable   String?
  bodyAreaPriorities   String?
  exerciseRestrictions String?
  aiSupportEnabled     Boolean   @default(false)

  weeks       Week[]
  exercises   Exercise[]
  bodyMetrics BodyMetric[]
  settings    ProgramSettings?
  templates   Template[]
}

model Exercise {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      ExerciseType
  createdAt DateTime     @default(now())

  workoutExercises WorkoutExercise[]
  sessionExercises SessionExercise[]
  templateExercises TemplateExercise[]

  @@unique([userId, name, type])
}

model Week {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number    Int
  createdAt DateTime @default(now())

  days WorkoutDay[]

  @@unique([userId, number])
}

// dayOfWeek: 0=Mon 1=Tue 2=Wed 3=Thu 4=Fri 5=Sat 6=Sun
model WorkoutDay {
  id        String   @id @default(cuid())
  weekId    String
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  name      String   // e.g. "Shoulders", "Rest"
  createdAt DateTime @default(now())

  exercises WorkoutExercise[]
  session   WorkoutSession?

  @@unique([weekId, dayOfWeek])
}

model WorkoutExercise {
  id            String     @id @default(cuid())
  workoutDayId  String
  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise   @relation(fields: [exerciseId], references: [id])
  order         Int
  plannedSets   Json
  notes         String?
  supersetGroup String? // shared value across exercises grouped into one superset
  restSeconds   Int? // rest timer duration; null = no timer for this exercise
}

model WorkoutSession {
  id           String     @id @default(cuid())
  workoutDayId String     @unique
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  startedAt    DateTime?
  completedAt  DateTime?
  durationSec  Int?

  sessionExercises SessionExercise[]
}

model SessionExercise {
  id            String         @id @default(cuid())
  sessionId     String
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise       @relation(fields: [exerciseId], references: [id])
  order         Int
  actualSets    Json
  notes         String?
  supersetGroup String?
  restSeconds   Int?
  // Set whenever the user edits/saves this exercise in a session. Lets the
  // app tell real edits apart from sets that were just auto-copied in.
  touchedAt     DateTime?
}

// One row per user. Stores the real calendar date their Week 1 / Day 1
// began, so "today" can be mapped onto a week number + day of week.
model ProgramSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
}

// A reusable, named exercise list independent of any specific week/day —
// e.g. "Push Day". Applying one to a day copies its exercises in, the same
// way duplicating a day does. Every new profile gets a starter Push/Pull/Legs
// set of these automatically.
model Template {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  exercises TemplateExercise[]
}

model TemplateExercise {
  id            String   @id @default(cuid())
  templateId    String
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  order         Int
  plannedSets   Json
  notes         String?
  supersetGroup String?
  restSeconds   Int?
}

// Extensible list of goal categories (Build Muscle, Lose Weight, etc).
// Admin-managed so new goals can be added without a code change.
model GoalCategory {
  id    String @id @default(cuid())
  key   String @unique // stable machine key, e.g. "build_muscle"
  label String // display label, e.g. "Build Muscle / Strength"
  order Int    @default(0)

  masterTemplates MasterTemplate[]
  users           User[]
}

// An admin-authored, owner-controlled program template. Deliberately has no
// link to any User — it stores plain exercise names/sets/reps, not
// references into anyone's personal Exercise catalog. "Using" a template
// (see /api/master-templates/[id]/use) reads this data and creates normal,
// fully independent Week/WorkoutDay/WorkoutExercise rows for the copying
// user — after that there is no relationship back to the master template,
// so admin edits here never affect anyone who already copied it.
model MasterTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  goalId            String?
  goal              GoalCategory? @relation(fields: [goalId], references: [id])
  difficulty        String? // "Beginner" | "Intermediate" | "Advanced"
  daysPerWeek       Int
  recommendedWeeks  Int?
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  days MasterTemplateDay[]
}

// dayOfWeek: 0=Mon .. 6=Sun — only the weekdays actually used need a row.
model MasterTemplateDay {
  id           String         @id @default(cuid())
  templateId   String
  template     MasterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  workoutName  String

  exercises MasterTemplateExercise[]
}

model MasterTemplateExercise {
  id           String            @id @default(cuid())
  templateDayId String
  templateDay  MasterTemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  type         ExerciseType
  sets         Int
  reps         Int?
  repRangeMin  Int?
  repRangeMax  Int?
  notes        String?
  restSeconds  Int?
}

model BodyMetric {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  weightKg     Float?
  heightCm     Float?
  bodyFatPct   Float?
  muscleMassKg Float?
  age          Int?
  sex          String?
}
